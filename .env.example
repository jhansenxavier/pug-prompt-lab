# Copie este arquivo para .env e preencha os valores.
# O .env NUNCA deve ir para o GitHub (já está no .gitignore).

# Provedor de IA: anthropic | openai | gemini | openai-compatible
AI_PROVIDER=anthropic

# Sua chave de API do provedor escolhido
# (opcional apenas para openai-compatible rodando local, como o Ollama)
AI_API_KEY=cole-sua-chave-aqui

# Modelo (opcional). Se ficar vazio, usa o padrão do provedor:
#   anthropic         -> claude-sonnet-4-5
#   openai            -> gpt-4.1-mini
#   gemini            -> gemini-2.5-flash
#   openai-compatible -> llama3.1
AI_MODEL=

# Só para openai-compatible (ou para trocar o endpoint da OpenAI). Exemplos:
#   Ollama:     http://localhost:11434/v1
#   Groq:       https://api.groq.com/openai/v1
#   OpenRouter: https://openrouter.ai/api/v1
AI_BASE_URL=

# Limite de tokens da resposta (Anthropic e Gemini)
AI_MAX_TOKENS=1024

# Porta do servidor local
PORT=3000
